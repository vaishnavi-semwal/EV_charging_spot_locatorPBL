#include <iostream>
#include <string>
#include <stdexcept>
#include <queue>
#include <vector>
using namespace std;

class Charger
{
private:
    int chargerID;
    string location;
    int totalSlots;
    float chargingPower;
    int carsCurrentlyCharging;
    int availableSlots;

    vector<int> chargingCars;
    queue<int> waitingCars;

public:
    Charger(int chargerID, string location, int totalSlots,
            float chargingPower)
    {
        if (chargerID <= 0)
            throw invalid_argument("Charger ID must be positive.");

        if (location.empty())
            throw invalid_argument("Location cannot be empty.");

        if (totalSlots <= 0 || totalSlots > 20)
            throw invalid_argument("Slots must be between 1 and 20.");

        if (chargingPower <= 0)
            throw invalid_argument("Charging power must be positive.");

        this->chargerID = chargerID;
        this->location = location;
        this->totalSlots = totalSlots;
        this->chargingPower = chargingPower;
        this->carsCurrentlyCharging = 0;
        this->availableSlots = totalSlots;
    }

    int getChargerID() 
    {
        return chargerID;
    }

    string getLocation() 
    {
        return location;
    }

    int getTotalSlots() 
    {
        return totalSlots;
    }

    float getChargingPower() 
    {
        return chargingPower;
    }

    int getCarsCurrentlyCharging() 
    {
        return carsCurrentlyCharging;
    }

    int getAvailableSlots() 
    {
        return availableSlots;
    }

    int getWaitingCount()
    {
        return waitingCars.size();
    }

    void addCarToQueue(int carID)
    {
        if (carID <= 0)
            throw invalid_argument("Car ID must be positive.");

        for (int i = 0; i < chargingCars.size(); i++)
        {
            if (chargingCars[i] == carID)
                throw runtime_error("Car is already charging.");
        }

        queue<int> temp = waitingCars;

        while (!temp.empty())
        {
            if (temp.front() == carID)
                throw runtime_error("Car is already waiting.");

            temp.pop();
        }

        waitingCars.push(carID);

        cout << "Car " << carID<< " added to the waiting queue.\n";
    }

    void removeCarFromQueue(int carID)
    {
        queue<int> temp;
        bool found = false;

        while (!waitingCars.empty())
        {
            int currentCar = waitingCars.front();
            waitingCars.pop();

            if (currentCar == carID && !found)
            {
                found = true;
            }
            else
            {
                temp.push(currentCar);
            }
        }

        waitingCars = temp;

        if (!found)
            throw runtime_error("Car not found in waiting queue.");

        cout << "Car " << carID
             << " removed from the waiting queue.\n";
    }
};

int main()
{
    try
    {
        Charger c1(101, "Dehradun", 4, 50.0f);

        cout << "Charger ID: " << c1.getChargerID() << "\n";
        cout << "Location: " << c1.getLocation() << "\n";
        cout << "Total slots: " << c1.getTotalSlots() << "\n";
        cout << "Charging power: " << c1.getChargingPower() << " kW\n";
        cout << "Available slots: "<< c1.getAvailableSlots() << "\n";

        c1.addCarToQueue(201);
        c1.addCarToQueue(202);

        cout << "Waiting cars: " << c1.getWaitingCount() << "\n";

        c1.removeCarFromQueue(201);

        cout << "Waiting cars after removal: "<< c1.getWaitingCount() << "\n";
    }
    catch (const exception& e)
    {
        cout << "Error: " << e.what() << "\n";
    }

    return 0;
}


    
