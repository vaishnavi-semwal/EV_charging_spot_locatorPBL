// Linked List Queue

class LinkedQueue
{
private:

    struct Node
    {
        int carID;
        Node* next;

        Node(int id)
        {
            carID = id;
            next = NULL;
        }
    };

    Node* frontNode;
    Node* rearNode;
    int count;

public:

    LinkedQueue()
    {
        frontNode = NULL;
        rearNode = NULL;
        count = 0;
    }

    // Copy constructor

    LinkedQueue(const LinkedQueue &q)
    {
        frontNode = NULL;
        rearNode = NULL;
        count = 0;

        Node* temp = q.frontNode;

        while (temp != NULL)
        {
            push(temp->carID);
            temp = temp->next;
        }
    }

    // Assignment operator

    LinkedQueue& operator=(const LinkedQueue &q)
    {
        if (this != &q)
        {
            clear();

            Node* temp = q.frontNode;

            while (temp != NULL)
            {
                push(temp->carID);
                temp = temp->next;
            }
        }

        return *this;
    }

    // Insert at rear

    void push(int carID)
    {
        Node* newNode = new Node(carID);

        if (frontNode == NULL)
        {
            frontNode = rearNode = newNode;
        }
        else
        {
            rearNode->next = newNode;
            rearNode = newNode;
        }

        count++;
    }

    // Delete from front

    int pop()
    {
        if (frontNode == NULL)
            throw runtime_error("Queue is empty.");

        Node* temp = frontNode;
        int carID = temp->carID;

        frontNode = frontNode->next;

        if (frontNode == NULL)
            rearNode = NULL;

        delete temp;
        count--;

        return carID;
    }

    int front()
    {
        if (frontNode == NULL)
            throw runtime_error("Queue is empty.");

        return frontNode->carID;
    }

    bool empty()
    {
        return frontNode == NULL;
    }

    int size()
    {
        return count;
    }

    void clear()
    {
        while (!empty())
            pop();
    }

    ~LinkedQueue()
    {
        clear();
    }
};


// Charger Class

class Charger
{
private:

    int chargerID;
    string location;
    int totalSlots;
    float chargingPower;

    int carsCurrentlyCharging;
    int availableSlots;

    vector<int> chargingCars;
    LinkedQueue waitingCars;

public:

    // Constructor

    Charger(int chargerID, string location, int totalSlots,
            float chargingPower)
    {
        if (chargerID <= 0 || location.empty() ||
            totalSlots <= 0 || totalSlots > 20 ||
            chargingPower <= 0)
        {
            throw invalid_argument("Invalid charger details.");
        }

        this->chargerID = chargerID;
        this->location = location;
        this->totalSlots = totalSlots;
        this->chargingPower = chargingPower;

        carsCurrentlyCharging = 0;
        availableSlots = totalSlots;
    }

    // Getters for Member 4

    int getChargerID()
    {
        return chargerID;
    }

    string getLocation()
    {
        return location;
    }

    int getTotalSlots()
    {
        return totalSlots;
    }

    float getChargingPower()
    {
        return chargingPower;
    }

    int getCarsCurrentlyCharging()
    {
        return carsCurrentlyCharging;
    }

    int getAvailableSlots()
    {
        return availableSlots;
    }

    int getWaitingCount()
    {
        return waitingCars.size();
    }

    // Provide waiting car IDs to Member 4

    vector<int> getWaitingCars()
    {
        vector<int> cars;

        LinkedQueue temp = waitingCars;

        while (!temp.empty())
        {
            cars.push_back(temp.pop());
        }

        return cars;
    }

    // Check whether car already exists

    bool containsCar(int carID)
    {
        for (int i = 0; i < chargingCars.size(); i++)
        {
            if (chargingCars[i] == carID)
                return true;
        }

        LinkedQueue temp = waitingCars;

        while (!temp.empty())
        {
            if (temp.front() == carID)
                return true;

            temp.pop();
        }

        return false;
    }

    // Check whether car is charging

    bool isCharging(int carID)
    {
        for (int i = 0; i < chargingCars.size(); i++)
        {
            if (chargingCars[i] == carID)
                return true;
        }

        return false;
    }

    // Automatically assign waiting cars

    void assignNextCar()
    {
        while (availableSlots > 0 && !waitingCars.empty())
        {
            int carID = waitingCars.pop();

            chargingCars.push_back(carID);

            carsCurrentlyCharging = chargingCars.size();

            availableSlots =
                totalSlots - carsCurrentlyCharging;

            cout << "Car " << carID
                 << " started charging at Charger "
                 << chargerID << endl;
        }
    }

    // Add car to waiting queue

    void addCarToQueue(int carID)
    {
        if (carID <= 0)
            throw invalid_argument("Invalid car ID.");

        if (containsCar(carID))
            throw runtime_error("Car already exists.");

        waitingCars.push(carID);

        cout << "\nCar " << carID
             << " added to waiting queue of Charger "
             << chargerID << endl;

        assignNextCar();
    }

    // Remove car from waiting queue

    void removeCarFromQueue(int carID)
    {
        LinkedQueue temp;
        bool found = false;

        while (!waitingCars.empty())
        {
            int current = waitingCars.pop();

            if (current == carID && !found)
            {
                found = true;
            }
            else
            {
                temp.push(current);
            }
        }

        waitingCars = temp;

        if (!found)
            throw runtime_error("Car not found in waiting queue.");

        cout << "\nCar " << carID
             << " removed from waiting queue of Charger "
             << chargerID << endl;

        assignNextCar();
    }

    // Finish charging

    void finishCharging(int carID)
    {
        bool found = false;

        for (int i = 0; i < chargingCars.size(); i++)
        {
            if (chargingCars[i] == carID)
            {
                chargingCars.erase(chargingCars.begin() + i);
                found = true;
                break;
            }
        }

        if (!found)
            throw runtime_error("Car is not charging.");

        cout << "\nCar " << carID
             << " completed charging at Charger "
             << chargerID << endl;

        carsCurrentlyCharging = chargingCars.size();

        availableSlots =
            totalSlots - carsCurrentlyCharging;

        assignNextCar();
    }

    // Calculate charging time

    float calculateChargingTime(float energy)
    {
        if (energy <= 0)
            throw invalid_argument("Invalid energy.");

        return energy / chargingPower;
    }

    // Display station summary

    void display()
    {
        cout << "\n========================================\n";
        cout << "       CHARGER STATION SUMMARY\n";
        cout << "========================================\n";

        cout << "Charger ID              : " << chargerID << endl;
        cout << "Location                : " << location << endl;
        cout << "Total Charging Slots    : " << totalSlots << endl;
        cout << "Available Slots         : " << availableSlots << endl;
        cout << "Occupied Slots          : " << carsCurrentlyCharging << endl;
        cout << "Charging Power          : " << chargingPower << " kW\n";

        cout << "\nCars Currently Charging : "
             << carsCurrentlyCharging << endl;

        cout << "Cars Waiting            : "
             << waitingCars.size() << endl;

        cout << "\nCars Charging: ";

        if (chargingCars.empty())
            cout << "None";

        for (int i = 0; i < chargingCars.size(); i++)
        {
            cout << chargingCars[i] << " ";
        }

        cout << "\nCars in Waiting List: ";

        LinkedQueue temp = waitingCars;

        if (temp.empty())
            cout << "None";

        while (!temp.empty())
        {
            cout << temp.pop() << " ";
        }

        cout << "\n========================================\n";
    }

    // Save charger information

    void saveToFile(ofstream &file)
    {
        file << chargerID << " "
             << quoted(location) << " "
             << totalSlots << " "
             << chargingPower << " ";

        file << chargingCars.size();

        for (int i = 0; i < chargingCars.size(); i++)
        {
            file << " " << chargingCars[i];
        }

        file << " " << waitingCars.size();

        LinkedQueue temp = waitingCars;

        while (!temp.empty())
        {
            file << " " << temp.pop();
        }

        file << endl;
    }

    // Load charger information

    static vector<Charger> loadFromFile()
    {
        vector<Charger> chargers;

        ifstream file("chargers.txt");

        if (!file)
            throw runtime_error("Cannot open chargers.txt.");

        int id, slots, chargingCount, waitingCount;
        float power;
        string location;

        while (file >> id)
        {
            if (!(file >> quoted(location) >> slots
                      >> power >> chargingCount))
            {
                throw runtime_error("Invalid file data.");
            }

            if (chargingCount < 0 || chargingCount > slots)
                throw runtime_error("Invalid charging data.");

            Charger c(id, location, slots, power);

            for (int i = 0; i < chargingCount; i++)
            {
                int carID;

                if (!(file >> carID) || carID <= 0)
                    throw runtime_error("Invalid car data.");

                if (c.containsCar(carID))
                    throw runtime_error("Duplicate car ID.");

                c.chargingCars.push_back(carID);
            }

            if (!(file >> waitingCount) || waitingCount < 0)
                throw runtime_error("Invalid waiting data.");

            for (int i = 0; i < waitingCount; i++)
            {
                int carID;

                if (!(file >> carID) || carID <= 0)
                    throw runtime_error("Invalid car data.");

                if (c.containsCar(carID))
                    throw runtime_error("Duplicate car ID.");

                c.waitingCars.push(carID);
            }

            // Check duplicate cars at other chargers

            for (int i = 0; i < chargers.size(); i++)
            {
                for (int j = 0; j < c.chargingCars.size(); j++)
                {
                    if (chargers[i].containsCar(c.chargingCars[j]))
                        throw runtime_error("Duplicate car ID in file.");
                }

                vector<int> waiting = c.getWaitingCars();

                for (int j = 0; j < waiting.size(); j++)
                {
                    if (chargers[i].containsCar(waiting[j]))
                        throw runtime_error("Duplicate car ID in file.");
                }
            }

            c.carsCurrentlyCharging = c.chargingCars.size();

            c.availableSlots =
                c.totalSlots - c.carsCurrentlyCharging;

            // Fill any available slots from waiting queue

            c.assignNextCar();

            chargers.push_back(c);
        }

        file.close();

        return chargers;
    }
};


// Save all chargers

void saveAll(vector<Charger> &chargers)
{
    ofstream file("chargers.txt");

    if (!file)
        throw runtime_error("Cannot save file.");

    for (int i = 0; i < chargers.size(); i++)
    {
        chargers[i].saveToFile(file);
    }

    file.close();
}


// Find charger using charger ID

int findChargerIndex(vector<Charger> &chargers, int chargerID)
{
    for (int i = 0; i < chargers.size(); i++)
    {
        if (chargers[i].getChargerID() == chargerID)
            return i;
    }

    return -1;
}


// Check whether car exists at any station

bool carAlreadyExists(vector<Charger> &chargers, int carID)
{
    for (int i = 0; i < chargers.size(); i++)
    {
        if (chargers[i].containsCar(carID))
            return true;
    }

    return false;
}


// Function used by Member 4
// Member 4 passes the selected charger ID and car ID

void addCarToSelectedCharger(vector<Charger> &chargers,
                             int chargerID, int carID)
{
    if (carAlreadyExists(chargers, carID))
        throw runtime_error("Car already exists.");

    int index = findChargerIndex(chargers, chargerID);

    if (index == -1)
        throw runtime_error("Selected charger not found.");

    chargers[index].addCarToQueue(carID);
}


// Remove a waiting car using charger ID

void removeWaitingCar(vector<Charger> &chargers,
                      int chargerID, int carID)
{
    int index = findChargerIndex(chargers, chargerID);

    if (index == -1)
        throw runtime_error("Charger ID not found.");

    chargers[index].removeCarFromQueue(carID);
}


// Process completed cars

void processCompletedCars(vector<Charger> &chargers)
{
    ifstream file("completed.txt");

    if (!file)
        return;

    int carID;

    while (file >> carID)
    {
        bool found = false;

        for (int i = 0; i < chargers.size(); i++)
        {
            if (chargers[i].isCharging(carID))
            {
                chargers[i].finishCharging(carID);
                found = true;
                break;
            }
        }

        if (!found)
        {
            cerr << "Completed car " << carID
                 << " was not found charging.\n";
        }
    }

    file.close();

    ofstream clearFile("completed.txt");
    clearFile.close();
}


// Process incoming cars selected by Member 4

// cars.txt format:
// carID chargerID

void processIncomingCars(vector<Charger> &chargers)
{
    ifstream file("cars.txt");

    if (!file)
        return;

    int carID, chargerID;

    while (file >> carID >> chargerID)
    {
        addCarToSelectedCharger(chargers, chargerID, carID);
    }

    file.close();

    ofstream clearFile("cars.txt");
    clearFile.close();
}


// Create charger details automatically

void createChargerFile()
{
    ifstream checkFile("chargers.txt");

    // Do not overwrite existing charger data

    if (checkFile.good())
    {
        checkFile.close();
        return;
    }

    checkFile.close();

    ofstream file("chargers.txt");

    if (!file)
        throw runtime_error("Cannot create charger file.");

    int ids[] = {1, 2, 3, 4, 5, 6, 7};

    string locations[] =
    {
        "Pacific Mall",
        "ISBT",
        "Rajpur Road",
        "Sahastradhara Road",
        "Prem Nagar",
        "Clement Town",
        "FRI"
    };

    int slots;
    float power;

    for (int i = 0; i < 7; i++)
    {
        cout << "\nEnter total slots for "
             << locations[i] << ": ";
        cin >> slots;

        cout << "Enter charging power (kW): ";
        cin >> power;

        if (slots <= 0 || slots > 20 || power <= 0)
            throw invalid_argument("Invalid charger details.");

        file << ids[i] << " "
             << quoted(locations[i]) << " "
             << slots << " "
             << power << " "
             << 0 << " "
             << 0 << endl;
    }

    file.close();

    cout << "\nCharger details saved successfully.\n";
}


// Main function

int main()
{
    try
    {
        createChargerFile();

        vector<Charger> chargers = Charger::loadFromFile();

        if (chargers.empty())
            throw runtime_error("No charger details found.");

        cout << "\nCHARGING STATION MANAGEMENT SYSTEM\n";

        cout << "\nCharger details loaded successfully.\n";

        // Process completed cars first

        processCompletedCars(chargers);

        // Receive selected charger IDs from Member 4

        processIncomingCars(chargers);

        // Save updated information

        saveAll(chargers);

        // Display each charger separately

        for (int i = 0; i < chargers.size(); i++)
        {
            chargers[i].display();
        }
    }
    catch (const exception &e)
    {
        cout << "\nError: " << e.what() << endl;
    }

    return 0;
}

    
